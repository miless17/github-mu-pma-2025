<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageViewObrazek"
        android:layout_width="242dp"
        android:layout_height="244dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <Button
        android:id="@+id/buttonObrazek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Vybrat obrázek"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewObrazek" />

    <Button
        android:id="@+id/buttonOtocit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Otočit"
        app:layout_constraintTop_toBottomOf="@+id/buttonObrazek"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonFiltr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtr"
        app:layout_constraintTop_toBottomOf="@id/buttonObrazek"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>