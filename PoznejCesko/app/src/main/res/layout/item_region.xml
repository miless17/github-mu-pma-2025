<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:rippleColor="#20000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/regionIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_mapmode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/design_default_color_primary" />

        <TextView
            android:id="@+id/regionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/lockIcon"
            app:layout_constraintStart_toEndOf="@id/regionIcon"
            app:layout_constraintTop_toTopOf="@id/regionIcon"
            tools:text="Praha" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/regionProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:indicatorColor="@color/design_default_color_primary"
            app:layout_constraintEnd_toEndOf="@id/regionName"
            app:layout_constraintStart_toStartOf="@id/regionName"
            app:layout_constraintTop_toBottomOf="@id/regionName"
            app:trackColor="#E0E0E0"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp"
            tools:progress="60" />

        <LinearLayout
            android:id="@+id/starsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/regionName"
            app:layout_constraintTop_toBottomOf="@id/regionProgress">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="#FFD700" />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="#FFD700" />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="#BDBDBD" />
        </LinearLayout>

        <ImageView
            android:id="@+id/lockIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@android:drawable/ic_lock_lock" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
